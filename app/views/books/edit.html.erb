<% content_for :title, "Editing #{@book.title}" %>

<%= turbo_frame_tag "book_modal" do %>
  <div class="fixed inset-0 z-50 overflow-hidden" data-controller="modal" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <!-- Backdrop overlay -->
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300"
         data-action="click->modal#closeOnBackdrop"></div>

    <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
      <div class="w-screen max-w-2xl bg-white shadow-2xl flex flex-col border-l border-slate-200">
        
        <!-- Header -->
        <div class="px-6 py-5 bg-gradient-to-r from-slate-900 via-slate-800 to-indigo-950 text-white flex items-center justify-between shadow-sm">
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-indigo-300">Edit Book</span>
            <h2 id="modal-title" class="text-2xl font-bold text-white leading-tight break-words">
              <%= @book.title %>
            </h2>
          </div>
          <div class="flex items-center gap-2">
            <%= link_to @book, data: { turbo_frame: "book_modal" }, class: "p-2 text-slate-400 hover:text-white hover:bg-white/10 rounded-xl transition-colors cursor-pointer", title: "Cancel and view details" do %>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            <% end %>
          </div>
        </div>

        <!-- Form (scrollable) -->
        <div class="flex-1 overflow-y-auto p-6">
          <%= render "form", book: @book %>
        </div>
      </div>
    </div>
  </div>
<% end %>
