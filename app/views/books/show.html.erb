<% content_for :title, @book.title %>

<%= turbo_frame_tag "book_modal" do %>
  <div class="fixed inset-0 z-50 overflow-hidden" data-controller="modal" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <!-- Backdrop overlay with blur -->
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300"
         data-action="click->modal#closeOnBackdrop"></div>

    <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
      <div class="w-screen max-w-2xl bg-white shadow-2xl flex flex-col border-l border-slate-200">
        
        <!-- Header -->
        <div class="px-6 py-5 bg-gradient-to-r from-slate-900 via-slate-800 to-indigo-950 text-white flex items-start justify-between shadow-sm">
          <div class="pr-4 flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-2 flex-wrap">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold uppercase tracking-wider
                <%= case @book.status
                    when 'want_to_read' then 'bg-amber-400/20 text-amber-300 border border-amber-400/30'
                    when 'currently_reading' then 'bg-teal-400/20 text-teal-300 border border-teal-400/30'
                    when 'read' then 'bg-purple-400/20 text-purple-300 border border-purple-400/30'
                    else 'bg-slate-700 text-slate-300'
                    end %>">
                <%= @book.status&.titleize %>
              </span>
              <% if @book.book_type.present? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-white/10 text-slate-200 border border-white/20">
                  <%= @book.book_type.titleize %>
                </span>
              <% end %>
              <% if @book.series.present? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                  <%= @book.series.name %>
                </span>
              <% end %>
            </div>
            <h2 id="modal-title" class="text-2xl font-bold text-white leading-tight break-words">
              <%= @book.title %>
            </h2>
            <% if @book.author.present? %>
              <p class="text-slate-300 text-sm mt-1">by <span class="font-medium text-white"><%= @book.author %></span></p>
            <% end %>
          </div>
          <button type="button"
                  data-action="click->modal#close"
                  class="p-2 text-slate-400 hover:text-white hover:bg-white/10 rounded-xl transition-colors cursor-pointer shrink-0"
                  title="Close (Esc)">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Scrollable Body Content -->
        <div class="flex-1 overflow-y-auto p-6 space-y-6">
          <% if notice.present? %>
            <div class="p-3 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm font-medium flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span><%= notice %></span>
            </div>
          <% end %>

          <!-- Top Section: Cover Image + Key Metadata -->
          <div class="flex flex-col sm:flex-row gap-6 items-start">
            <% if @book.cover_image_url.present? %>
              <div class="shrink-0 w-36 sm:w-44 rounded-xl overflow-hidden shadow-lg border border-slate-200 bg-slate-100 mx-auto sm:mx-0">
                <%= image_tag @book.cover_image_url, alt: @book.title, class: "w-full h-auto object-cover" %>
              </div>
            <% else %>
              <div class="shrink-0 w-36 sm:w-44 h-52 sm:h-60 rounded-xl shadow-md border border-slate-200 bg-gradient-to-br from-slate-100 via-indigo-50 to-blue-100 flex flex-col items-center justify-center p-4 text-center mx-auto sm:mx-0">
                <svg class="w-12 h-12 text-slate-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
                <span class="text-xs font-semibold text-slate-600 line-clamp-3"><%= @book.title %></span>
                <span class="text-[10px] text-slate-400 mt-1"><%= @book.author %></span>
              </div>
            <% end %>

            <div class="flex-1 w-full space-y-4">
              <!-- Rating -->
              <% if @book.rating.present? %>
                <div class="p-4 bg-amber-50/80 border border-amber-200/80 rounded-xl flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <svg class="w-6 h-6 text-amber-500 fill-amber-500" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    <div>
                      <p class="text-xs font-medium text-amber-800 uppercase tracking-wide">Rating</p>
                      <p class="text-xl font-bold text-amber-900"><%= @book.rating %> <span class="text-sm font-normal text-amber-700">/ 10</span></p>
                    </div>
                  </div>
                </div>
              <% end %>

              <!-- Quick Details Grid -->
              <div class="grid grid-cols-2 gap-3 text-sm">
                <% if @book.publication_year.present? %>
                  <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <span class="block text-xs font-medium text-slate-500">Published</span>
                    <span class="font-semibold text-slate-900"><%= @book.publication_year %></span>
                  </div>
                <% end %>

                <% if @book.page_count.present? %>
                  <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <span class="block text-xs font-medium text-slate-500">Pages</span>
                    <span class="font-semibold text-slate-900"><%= @book.page_count %></span>
                  </div>
                <% end %>

                <% if @book.publisher.present? %>
                  <div class="p-3 bg-slate-50 rounded-xl border border-slate-100 col-span-2">
                    <span class="block text-xs font-medium text-slate-500">Publisher</span>
                    <span class="font-semibold text-slate-900"><%= @book.publisher %></span>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Reading Timeline -->
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80">
            <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-3">Reading Activity</h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
              <div>
                <span class="block text-xs text-slate-500">Date Added</span>
                <span class="font-medium text-slate-800"><%= @book.date_added&.strftime("%b %d, %Y") || @book.created_at.strftime("%b %d, %Y") %></span>
              </div>
              <div>
                <span class="block text-xs text-slate-500">Started</span>
                <span class="font-medium text-slate-800"><%= @book.date_started&.strftime("%b %d, %Y") || "—" %></span>
              </div>
              <div>
                <span class="block text-xs text-slate-500">Finished</span>
                <span class="font-medium text-slate-800"><%= @book.date_finished&.strftime("%b %d, %Y") || "—" %></span>
              </div>
            </div>
          </div>

          <!-- Description -->
          <% if @book.description.present? %>
            <div class="space-y-2">
              <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Description</h3>
              <div class="text-sm text-slate-700 leading-relaxed bg-white p-4 rounded-xl border border-slate-200/80 max-h-60 overflow-y-auto whitespace-pre-line">
                <%= @book.description %>
              </div>
            </div>
          <% end %>

          <!-- Notes / Comments -->
          <% if @book.comments.present? %>
            <div class="space-y-2">
              <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">My Notes & Comments</h3>
              <div class="text-sm text-slate-800 bg-amber-50/50 p-4 rounded-xl border border-amber-200/80 whitespace-pre-line">
                <%= @book.comments %>
              </div>
            </div>
          <% end %>

          <!-- Identifiers -->
          <div class="border-t border-slate-200 pt-4 space-y-2 text-xs text-slate-500">
            <div class="flex flex-wrap gap-x-6 gap-y-1">
              <% if @book.isbn_13.present? %>
                <div><strong class="font-medium text-slate-700">ISBN-13:</strong> <%= @book.isbn_13 %></div>
              <% end %>
              <% if @book.isbn_10.present? %>
                <div><strong class="font-medium text-slate-700">ISBN-10:</strong> <%= @book.isbn_10 %></div>
              <% end %>
              <% if @book.open_library_id.present? %>
                <div>
                  <strong class="font-medium text-slate-700">OpenLibrary:</strong>
                  <%= link_to @book.open_library_id, "https://openlibrary.org/works/#{@book.open_library_id}", target: "_blank", rel: "noopener", class: "text-blue-600 hover:underline" %>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Sticky Footer Actions -->
        <div class="p-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <%= link_to edit_book_path(@book),
                data: { turbo_frame: "book_modal" },
                class: "inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-xl shadow-xs hover:shadow transition-all text-sm" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              <span>Edit Book</span>
            <% end %>

            <%= button_to @book,
                method: :delete,
                data: { turbo_confirm: "Are you sure you want to delete this book?" },
                class: "inline-flex items-center gap-2 px-3 py-2.5 text-red-600 hover:text-red-700 hover:bg-red-50 rounded-xl transition-colors text-sm font-medium",
                form_class: "inline" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
              <span>Delete</span>
            <% end %>
          </div>

          <button type="button"
                  data-action="click->modal#close"
                  class="px-4 py-2.5 text-slate-600 hover:text-slate-900 hover:bg-slate-200/60 rounded-xl font-medium text-sm transition-colors cursor-pointer">
            Close
          </button>
        </div>
      </div>
    </div>
  </div>
<% end %>
