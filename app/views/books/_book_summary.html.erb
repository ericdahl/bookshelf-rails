<div class="col-span-3">
  <%= link_to book_path(book), data: { turbo_frame: "book_modal" }, class: "group/link inline-block max-w-full" do %>
    <h3 class="font-semibold text-slate-900 group-hover/link:text-blue-600 transition-colors truncate">
      <%= book.title %>
    </h3>
  <% end %>
</div>

<div class="col-span-2">
  <span class="text-slate-600 truncate block text-sm"><%= book.author.presence || "—" %></span>
</div>

<div class="col-span-2">
  <% if book.series.present? %>
    <%= link_to book.series.name, series_path(book.series), class: "text-slate-700 hover:text-indigo-600 truncate block text-sm font-medium hover:underline", data: { turbo_frame: "_top" } %>
  <% else %>
    <span class="text-slate-400 text-sm">—</span>
  <% end %>
</div>

<div class="col-span-2">
  <% if book.book_type.present? %>
    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">
      <%= book.book_type.titleize %>
    </span>
  <% else %>
    <span class="text-slate-400 text-sm">—</span>
  <% end %>
</div>

<div class="col-span-1">
  <% if book.rating.present? %>
    <div class="flex items-center gap-1">
      <svg class="w-4 h-4 text-amber-500 fill-amber-500 shrink-0" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
      </svg>
      <span class="text-sm font-semibold text-slate-700"><%= book.rating %></span>
    </div>
  <% else %>
    <span class="text-slate-400 text-sm">—</span>
  <% end %>
</div>

<div class="col-span-2 flex justify-end items-center gap-1">
  <%= link_to book_path(book), data: { turbo_frame: "book_modal" }, class: "p-2 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-all", title: "View details" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
    </svg>
  <% end %>

  <%= link_to edit_book_path(book), data: { turbo_frame: "book_modal" }, class: "p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all", title: "Edit book" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
    </svg>
  <% end %>

  <%= button_to book, method: :delete, class: "p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all cursor-pointer", form_class: "inline", data: { turbo_stream: true, turbo_confirm: "Are you sure you want to delete this book?" }, title: "Delete book" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
    </svg>
  <% end %>
</div>
