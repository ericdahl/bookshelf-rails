<% content_for :title, "Add New Book" %>

<div class="max-w-3xl mx-auto px-4 py-8">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-slate-900">Add New Book</h1>
      <p class="text-slate-600 mt-1">Enter the details of the book you want to add to your library.</p>
    </div>
    <%= link_to books_path, class: "inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 shadow-xs transition-colors" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <span>Back to Library</span>
    <% end %>
  </div>

  <div class="bg-white rounded-2xl shadow-xl border border-slate-200/80 p-8">
    <%= render "form", book: @book %>
  </div>
</div>
